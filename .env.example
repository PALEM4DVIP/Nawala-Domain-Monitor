# Isi ini di Vercel Dashboard > Project > Settings > Environment Variables
# (bukan file .env biasa — Vercel serverless tidak baca file .env saat runtime produksi)

# Otomatis terisi kalau kamu connect Upstash Redis lewat
# Vercel Dashboard > Storage > Marketplace Database Providers > Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dari @BotFather
TELEGRAM_BOT_TOKEN=

# Dari @userinfobot atau endpoint getUpdates
TELEGRAM_CHAT_ID=

# String acak bebas (min. 20 karakter) — dipakai untuk melindungi
# endpoint /api/cron/scan supaya tidak sembarang orang bisa memicunya.
# Buat dengan: openssl rand -hex 24
CRON_SECRET=

# Resolver DNS untuk cek Nawala (opsional, ada default di kode)
DNS_RESOLVER_CLEAN=8.8.8.8
DNS_RESOLVER_ISP=202.152.0.2,203.130.196.5
